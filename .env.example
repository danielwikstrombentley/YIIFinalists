# Local-only secrets and configuration for the kiosk sidecar and content pipeline.
# Copy this file to .env.local, fill the values, and never commit .env.local.

# Long Cesium ion access-token credential; not a numeric asset ID.
ION_ACCESS_TOKEN=

# Positive numeric Cesium ion asset ID for Google Photorealistic 3D Tiles.
ION_GOOGLE_TILES_ASSET_ID=

# Opt the generated local sample release into streamed tiles. The code default is
# safe-composition so offline fixtures and automated browser tests remain deterministic.
YII_SAMPLE_TILE_TIER=photorealistic

# Prep-time content-pipeline credentials. Configure only providers you use; these values are never
# copied into draft records or runtime packages.
CLICKUP_API_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional drafting provider/model overrides. A tracked pipeline.config.json may instead select
# the provider and per-provider model ids; credentials always remain environment-only.
PIPELINE_LLM_PROVIDER=openai
PIPELINE_LLM_MODEL=