{
  "name": "@yii/content-schema",
  "private": true,
  "version": "0.0.0",
  "description": "Zod schemas + JSON Schema export for the published content package and editorial records.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:unit": "vitest run",
    "export:json-schema": "tsx scripts/export-json-schema.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
